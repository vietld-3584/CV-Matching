# Azure Document Intelligence (CV text extraction)
AZURE__ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE__REGION=japaneast
AZURE__KEY=<your-azure-key>

# LiteLLM (scoring + extraction model)
CV_MATCHING_LITELLM__URL=https://llm.sun-asterisk.ai/v1
CV_MATCHING_LITELLM__API_KEY=<your-litellm-key>
CV_MATCHING_LITELLM__MODEL=gemini-3.1-flash-lite-preview
CV_MATCHING_LITELLM__TIMEOUT=90
CV_MATCHING_LITELLM__MAX_RETRIES=2
# CV_MATCHING_LITELLM__REASONING_EFFORT=low

# Auth - the value clients must send in the X-API-Key header
AUTH__API_KEY=<your-api-key>

# Application (defaults reproduce the routes used before the service was split out)
# ROOT_PATH=/ai
# SERVICE_PREFIX=/cv-matching
# API_PREFIX=/api/v1
# ENVIRONMENT=development
